# 开发用：Shift+D 打开开发者菜单后执行 show screen aff_debug 可查看当前隐藏分
screen aff_debug():
    zorder 200
    frame:
        xalign 0.02
        yalign 0.02
        vbox:
            text "LKC [aff_lkc]　LJQ [aff_ljq]" size 24
            text "WHT [aff_wht]　WZH [aff_wzh]" size 24

screen epi():
    frame:
        xalign 0.95
        yalign 0.05
        xpadding 20
        ypadding 20
        at showep
            
        vbox:
            text "Episode [ep]" size 50

transform ch(x=0.5, z=0.75, fade=0.5):
    xcenter x
    yalign 1.0
    zoom z
    alpha 0.0
    linear 0.5 alpha 1.0

transform ch_slide(x_from=2000, x_to=480, z=0.75, t=0.5, fade=0.5):
    xcenter x_from
    yalign 1.0
    zoom z
    alpha 0.0
    parallel:
        linear t xcenter x_to
    parallel:
        linear fade alpha 1.0

transform ch_move(x_from=480, x_to=800, z=0.75, t=0.5):
    xcenter x_from
    yalign 1.0
    zoom z
    linear t xcenter x_to

transform showep:
    xalign 0.95
    yalign 0.05
    on show:
        xoffset config.screen_width
        easein 0.5 xoffset 0
    on hide:
        easeout 0.5 xoffset config.screen_width

